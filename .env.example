# Environment for `docker compose up -d postgresql`
#
#   cp .env.example .env && docker compose up -d postgresql
#
# Every variable the compose file refuses to invent is here, with what it is for.
# The README's five-minute path sets three of them inline instead, because it
# should be readable without this file. If you skip that and run `docker compose`
# on a fresh clone, you will hit the errors one at a time -- compose names only
# the first missing value per run.
#
# These are development values. None is a secret worth keeping, and none of them
# is read by a running service outside this container.

# --- required by compose; the build fails without each one ---------------

# Password for the `mindpalace_runtime` role: the identity the product uses at
# runtime, as distinct from `mpadmin`, which owns the schema.
MIND_PALACE_RUNTIME_PASSWORD=choose-a-local-password

# Name of that role. Defaults to `mindpalace_runtime` if unset.
MIND_PALACE_RUNTIME_USER=mindpalace_runtime

# Directories the API may read documents from. A path outside this list is
# refused with a 403, including on the CLI's `ingest-repo`. Use `$PWD` to
# ingest from wherever you cloned the repository, or `/content` to match the
# README's example.
MIND_PALACE_INGEST_ROOTS=$PWD

# Signs and verifies the opaque `cursor` values that `changes` and `history`
# hand out. Rotating it invalidates every cursor already in a caller's hand.
# Must be 32 characters or more; anything shorter is rejected.
#
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
MIND_PALACE_CURSOR_SECRET=replace-me-with-32-or-more-characters-of-secret

# --- not required by compose, but the first commands need them -----------

# The database `mpadmin` connects to. Set this in your shell after the compose
# step, not here: `docker compose` starts the server, and the migrations that
# create the schema run afterwards.
#
#   export DATABASE_URL=postgresql://mpadmin:secret@localhost:5432/mindpalace
#   python -m alembic -c migrations/alembic.ini upgrade head
DATABASE_URL=postgresql://mpadmin:secret@localhost:5432/mindpalace